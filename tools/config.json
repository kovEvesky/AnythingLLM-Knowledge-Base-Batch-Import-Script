{
    "baseUrl":  "http://localhost:3001",
    "probeTimeoutSec":  5,
    "uploadTimeoutSec":  300,
    "embedTimeoutSec":  120,
    "chatTimeoutSec":  300,
    "apiTimeoutSec":  60,
    "verifyTimeoutSec":  300,
    "verifyBaseIntervalSec":  2,
    "verifyMaxIntervalSec":  5,
    "uploadRetryCount":  2,
    "uploadRetryBaseDelaySec":  2,
    "allowedExtensions":  [
                              ".pdf",
                              ".docx",
                              ".doc",
                              ".txt",
                              ".md",
                              ".csv",
                              ".xlsx",
                              ".pptx",
                              ".org",
                              ".adoc",
                              ".rst",
                              ".json",
                              ".html",
                              ".odt",
                              ".odp"
                          ],
    "maxFileSizeMB":  100,
    "defaultWorkspace":  "",
    "askForChatTest":  false,
    "chatMode":  "query",
    "detectDuplicates":  true,
    "duplicateDefaultAction":  "ask",
    "logDir":  "logs",
    "logRetentionDays":  30,
    "useTrueColor":  true,
    "filenamePolicy":  "unicode"
}